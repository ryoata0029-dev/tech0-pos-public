{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "japaneast",
      "allowedValues": [
        "japaneast"
      ]
    },
    "planName": {
      "type": "string"
    },
    "frontendName": {
      "type": "string"
    },
    "backendName": {
      "type": "string"
    },
    "frontendOutboundCidrs": {
      "type": "array",
      "defaultValue": []
    },
    "operatorCidrs": {
      "type": "array",
      "defaultValue": []
    },
    "enableApps": {
      "type": "bool",
      "defaultValue": false
    }
  },
  "resources": [
    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2024-11-01",
      "name": "[parameters('planName')]",
      "location": "[parameters('location')]",
      "kind": "linux",
      "sku": {
        "name": "B1",
        "tier": "Basic",
        "capacity": 1
      },
      "properties": {
        "reserved": true,
        "perSiteScaling": false
      }
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2024-11-01",
      "name": "[parameters('frontendName')]",
      "location": "[parameters('location')]",
      "kind": "app,linux",
      "dependsOn": [
        "[resourceId('Microsoft.Web/serverfarms',parameters('planName'))]"
      ],
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms',parameters('planName'))]",
        "httpsOnly": true,
        "enabled": "[parameters('enableApps')]",
        "clientAffinityEnabled": false,
        "siteConfig": {
          "alwaysOn": true,
          "numberOfWorkers": 1,
          "linuxFxVersion": "NODE|24-lts",
          "appCommandLine": "sh infra/start-frontend.sh",
          "ftpsState": "Disabled",
          "minTlsVersion": "1.2",
          "scmMinTlsVersion": "1.2",
          "remoteDebuggingEnabled": false,
          "httpLoggingEnabled": false,
          "healthCheckPath": "/health",
          "scmIpSecurityRestrictionsDefaultAction": "Deny",
          "copy": [
            {
              "name": "scmIpSecurityRestrictions",
              "count": "[length(parameters('operatorCidrs'))]",
              "input": {
                "name": "[concat('operator-',copyIndex('scmIpSecurityRestrictions'))]",
                "ipAddress": "[parameters('operatorCidrs')[copyIndex('scmIpSecurityRestrictions')]]",
                "action": "Allow",
                "priority": "[add(100,copyIndex('scmIpSecurityRestrictions'))]"
              }
            }
          ],
          "ipSecurityRestrictionsDefaultAction": "Allow"
        }
      }
    },
    {
      "type": "Microsoft.Web/sites/config",
      "apiVersion": "2022-09-01",
      "name": "[concat(parameters('frontendName'),'/logs')]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites',parameters('frontendName'))]"
      ],
      "properties": {
        "applicationLogs": {
          "fileSystem": {
            "level": "Information"
          }
        },
        "httpLogs": {
          "fileSystem": {
            "enabled": false
          }
        },
        "detailedErrorMessages": {
          "enabled": false
        },
        "failedRequestsTracing": {
          "enabled": false
        }
      }
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2024-11-01",
      "name": "[parameters('backendName')]",
      "location": "[parameters('location')]",
      "kind": "app,linux",
      "dependsOn": [
        "[resourceId('Microsoft.Web/serverfarms',parameters('planName'))]"
      ],
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms',parameters('planName'))]",
        "httpsOnly": true,
        "enabled": "[parameters('enableApps')]",
        "clientAffinityEnabled": false,
        "siteConfig": {
          "alwaysOn": true,
          "numberOfWorkers": 1,
          "linuxFxVersion": "PYTHON|3.13",
          "appCommandLine": "sh infra/start-backend.sh",
          "ftpsState": "Disabled",
          "minTlsVersion": "1.2",
          "scmMinTlsVersion": "1.2",
          "remoteDebuggingEnabled": false,
          "httpLoggingEnabled": false,
          "healthCheckPath": "/health",
          "scmIpSecurityRestrictionsDefaultAction": "Deny",
          "copy": [
            {
              "name": "scmIpSecurityRestrictions",
              "count": "[length(parameters('operatorCidrs'))]",
              "input": {
                "name": "[concat('operator-',copyIndex('scmIpSecurityRestrictions'))]",
                "ipAddress": "[parameters('operatorCidrs')[copyIndex('scmIpSecurityRestrictions')]]",
                "action": "Allow",
                "priority": "[add(100,copyIndex('scmIpSecurityRestrictions'))]"
              }
            },
            {
              "name": "ipSecurityRestrictions",
              "count": "[length(parameters('frontendOutboundCidrs'))]",
              "input": {
                "name": "[concat('relay-',copyIndex('ipSecurityRestrictions'))]",
                "ipAddress": "[parameters('frontendOutboundCidrs')[copyIndex('ipSecurityRestrictions')]]",
                "action": "Allow",
                "priority": "[add(100,copyIndex('ipSecurityRestrictions'))]"
              }
            }
          ],
          "ipSecurityRestrictionsDefaultAction": "Deny"
        }
      }
    },
    {
      "type": "Microsoft.Web/sites/config",
      "apiVersion": "2022-09-01",
      "name": "[concat(parameters('backendName'),'/logs')]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites',parameters('backendName'))]"
      ],
      "properties": {
        "applicationLogs": {
          "fileSystem": {
            "level": "Information"
          }
        },
        "httpLogs": {
          "fileSystem": {
            "enabled": false
          }
        },
        "detailedErrorMessages": {
          "enabled": false
        },
        "failedRequestsTracing": {
          "enabled": false
        }
      }
    }
  ],
  "outputs": {}
}
