# M2 reads environment variables. It does not implicitly load .env files.
# Supply secrets outside source control. No working credentials are included.
POS_FRONTEND_ORIGIN=https://pos-validation.example.invalid
POS_RELAY_SECRET=
POS_DB_HOST=
POS_DB_PORT=3306
POS_DB_NAME=pos_validation
POS_DB_USER=
POS_DB_PASSWORD=
POS_DB_SSL_CA=
# TLS hostname verification, UTC and READ COMMITTED are enforced by the connection layer.

# Set the reviewed release id in deployed environment.
POS_DEPLOYMENT_VERSION=
