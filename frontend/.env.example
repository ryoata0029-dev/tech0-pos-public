# M2 server-only relay settings; never exposed to browser JavaScript.
# Never prefix secrets or the backend connection settings with NEXT_PUBLIC_.
POS_BACKEND_URL=https://pos-api-validation.example.invalid
POS_RELAY_SECRET=
NEXT_TELEMETRY_DISABLED=1
POS_FRONTEND_ORIGIN=https://pos-validation.example.invalid

# Set the reviewed release id in deployed environment.
POS_DEPLOYMENT_VERSION=
# Build-time only; 1 enables in-memory UI timing capture without identifiers.
NEXT_PUBLIC_POS_MEASUREMENTS=0
